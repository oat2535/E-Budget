        <mxCell id="e28" edge="1" parent="1" source="p_plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E7C99;strokeWidth=1.3;endArrow=block;endFill=1;fontSize=9;fontColor=#0E7C99;fontFamily=Tahoma;" target="p_plan_detail" value="มีรายละเอียดรายเดือน (FK, บังคับ)">
