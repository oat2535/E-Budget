        <!-- ============ Monthly detail ============ -->
        <mxCell id="d_detail" value="&lt;b&gt;ebudget_monthly_detail&lt;/b&gt;&lt;br&gt;&lt;i&gt;(รายละเอียดงบประมาณรายเดือน)&lt;/i&gt;&lt;hr size=1&gt;id : bigint &lt;i&gt;(คีย์หลัก)&lt;/i&gt;&lt;br&gt;month : int&lt;br&gt;headcount : decimal&lt;br&gt;cost : decimal&lt;br&gt;vet_budget_id : bigint (FK, NULL ได้)&lt;br&gt;non_vet_budget_id : bigint (FK, NULL ได้)&lt;br&gt;position_adj_id : bigint (FK, NULL ได้)&lt;br&gt;med_equip_id : bigint (FK, NULL ได้)&lt;br&gt;comp_equip_id : bigint (FK, NULL ได้)&lt;br&gt;furniture_equip_id : bigint (FK, NULL ได้)&lt;br&gt;tools_equip_id : bigint (FK, NULL ได้)&lt;br&gt;&lt;i&gt;หมายเหตุ: แต่ละแถวมีค่าไม่ null แค่ 1 คอลัมน์เท่านั้น&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FBF0E1;strokeColor=#A6631E;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1">
