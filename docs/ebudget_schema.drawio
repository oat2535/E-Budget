        <!-- ============ Notes (Thai) ============ -->
        <mxCell id="notes_h" value="หมายเหตุ" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="2480" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="1. cost_center_name และ base_branch_id เป็นข้อความธรรมดา (string) ในทุกแถวของตารางงบประมาณ ไม่ใช่ Foreign Key — เป็นการตัดสินใจตั้งใจตอนสร้างฟีเจอร์ Cost Center เพราะชื่อศูนย์ต้นทุนอาจถูกเปลี่ยนภายหลังใน ebudget_cost_center_master ได้ โดยไม่ต้องบังคับให้ทุกแถวประวัติเปลี่ยนตาม ส่วน base_branch_id ก็ดึงมาจากระบบ imedx ภายนอกเพียงครั้งเดียวตอนบันทึก ไม่ได้ query สดทุกครั้งที่เปิดดู" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#8A93A3;strokeWidth=1;arcSize=6;fontFamily=Tahoma;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2520" width="1080" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="2. ทั้ง 7 ตารางบันทึกงบประมาณไม่มี abstract base class ร่วมกันใน budget_app/models.py — ฟิลด์อย่าง position_name / salary / base_branch_id / cost_center_name / audit fields ถูกประกาศแยกกันในแต่ละคลาส โครงสร้างเหมือนกันทุกตัวอักษรแต่ต้องแก้ไขทีละ 7 จุดทุกครั้งที่เพิ่มฟิลด์ใหม่ (เช่นตอนเพิ่ม cost_center_name)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#8A93A3;strokeWidth=1;arcSize=6;fontFamily=Tahoma;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2645" width="1080" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="3. ebudget_monthly_detail เชื่อมกับตารางแม่ผ่าน Foreign Key แยกกัน 7 ตัว (vet_budget_id ... tools_equip_id) แทนที่จะใช้ FK แบบ generic ตัวเดียว — แต่ละแถวจะมีค่าไม่ null แค่คอลัมน์เดียว ตรงกับตารางงบประมาณที่แถวนั้นสังกัดอยู่จริง เป็นความสัมพันธ์จริงตามปกติ เพียงแต่กระจายอยู่ใน 7 คอลัมน์แทนที่จะเป็นคอลัมน์เดียว" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#8A93A3;strokeWidth=1;arcSize=6;fontFamily=Tahoma;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2745" width="1080" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="4. มี 2 ระบบที่ตั้งใจไม่นำมาแสดงในผังนี้: ตาราง auth_user / session ของ Django เอง (ใช้สำหรับ login เท่านั้น ไม่ได้ปรับแต่งเพิ่ม และไม่มีตารางไหนอ้างอิงด้วย FK เลย — create_eid / modify_eid เป็นเพียง string รหัสพนักงานธรรมดา) และ imedx ซึ่งเป็นฐานข้อมูล PostgreSQL ภายนอกแยกต่างหาก เข้าถึงผ่าน raw SQL เพื่อดึงรหัสสาขาเท่านั้น ไม่มี Django model หรือ migration ใดๆ ของ imedx อยู่ในโปรเจกต์นี้เลย" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#8A93A3;strokeWidth=1;arcSize=6;fontFamily=Tahoma;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2845" width="1080" height="110" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="หมายเหตุการตั้งชื่อตาราง: ตารางของแอป master_data จะ migrate เป็นชื่อ master_data_ebudget_..._master (ชื่อ default ของ Django) ส่วนตารางของแอป budget_app override Meta.db_table ให้ตรงกับชื่อคลาสเป๊ะๆ โดยไม่มี prefix ของแอปนำหน้า — ทั้งสองรูปแบบการตั้งชื่ออยู่ในฐานข้อมูลเดียวกันโดยตั้งใจ ไม่ใช่ความผิดพลาด" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6472;fontStyle=2;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="2965" width="1080" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
