        <mxCell id="e24" edge="1" parent="1" source="b_furn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A6631E;strokeWidth=1.3;endArrow=block;endFill=1;fontSize=9;fontColor=#A6631E;fontFamily=Tahoma;" target="d_detail" value="มีรายละเอียดรายเดือน (FK)">
