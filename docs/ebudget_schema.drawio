        <!-- ============ Loose reference (not FK), representative edge ============ -->
        <mxCell id="e26" value="cost_center_name — ทุกตารางในกลุ่ม Budget Records (ไม่ใช่ FK, ดูหมายเหตุ 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=9.5;fontColor=#5B6472;fontFamily=Tahoma;exitX=0.5;exitY=1;entryX=0;entryY=0.9;" edge="1" parent="1" source="m_cc" target="b_vet">
          <mxGeometry relative="1" as="geometry" />
