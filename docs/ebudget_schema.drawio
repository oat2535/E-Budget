        <mxCell id="e26" edge="1" parent="1" source="m_cc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=9.5;fontColor=#5B6472;fontFamily=Tahoma;exitX=0.5;exitY=1;entryX=0;entryY=0.9;" target="b_vet" value="cost_center_name — ทุกตารางที่มีฟิลด์นี้ (ไม่ใช่ FK, ดูหมายเหตุ 1)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e27" edge="1" parent="1" source="g_gl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7B3FA0;strokeWidth=1.3;endArrow=block;endFill=1;fontSize=9;fontColor=#7B3FA0;fontFamily=Tahoma;" target="g_gl_detail" value="มีรายละเอียดรายเดือน (FK, บังคับ)">
