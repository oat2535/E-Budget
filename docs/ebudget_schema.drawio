        <!-- ============ Header ============ -->
        <mxCell id="hdr_title" value="แผนผังฐานข้อมูล E-Budget" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="ผังความสัมพันธ์ของทุกตารางในระบบ E-Budget (Django 2 แอป: budget_app, master_data) พร้อมระบุจุดที่ตั้งใจไม่ทำเป็น Foreign Key" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5B6472;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hdr_legend" value="&lt;span style=&quot;color:#23806C&quot;&gt;■&lt;/span&gt; ข้อมูลหลัก (Master Data) &amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#2E5AAC&quot;&gt;■&lt;/span&gt; ตารางบันทึกงบประมาณ (Budget Records, 7 ตาราง) &amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#A6631E&quot;&gt;■&lt;/span&gt; รายละเอียดรายเดือน (Monthly Detail) &amp;nbsp;&amp;nbsp;&amp;nbsp; ─── FK จริง &amp;nbsp;&amp;nbsp; ┄┄┄ อ้างอิงแบบ string (ไม่ใช่ FK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1080" height="30" as="geometry" />
        </mxCell>

        <!-- ============ Master data column ============ -->
        <mxCell id="m_glm" value="&lt;b&gt;ebudget_general_ledger_master&lt;/b&gt;&lt;br&gt;&lt;i&gt;(บัญชีแยกประเภททั่วไป)&lt;/i&gt;&lt;hr size=1&gt;id : bigint &lt;i&gt;(คีย์หลัก)&lt;/i&gt;&lt;br&gt;gl_code : string (unique)&lt;br&gt;gl_name : string" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E3F2EE;strokeColor=#23806C;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m_cat" value="&lt;b&gt;ebudget_budget_category_master&lt;/b&gt;&lt;br&gt;&lt;i&gt;(หมวดหมู่งบประมาณ)&lt;/i&gt;&lt;hr size=1&gt;id : bigint &lt;i&gt;(คีย์หลัก)&lt;/i&gt;&lt;br&gt;category_code : string (unique)&lt;br&gt;category_name : string" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E3F2EE;strokeColor=#23806C;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m_sub" value="&lt;b&gt;ebudget_budget_sub_category_master&lt;/b&gt;&lt;br&gt;&lt;i&gt;(หมวดหมู่ย่อย)&lt;/i&gt;&lt;hr size=1&gt;id : bigint &lt;i&gt;(คีย์หลัก)&lt;/i&gt;&lt;br&gt;category_id : bigint (FK)&lt;br&gt;sub_category_code : string (unique)&lt;br&gt;sub_category_name : string" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E3F2EE;strokeColor=#23806C;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_item" value="&lt;b&gt;ebudget_budget_item_master&lt;/b&gt;&lt;br&gt;&lt;i&gt;(รายการ/ตำแหน่งมาตรฐาน)&lt;/i&gt;&lt;hr size=1&gt;id : bigint &lt;i&gt;(คีย์หลัก)&lt;/i&gt;&lt;br&gt;general_ledger_id : bigint (FK, NULL ได้)&lt;br&gt;category_id : bigint (FK, NULL ได้)&lt;br&gt;sub_category_id : bigint (FK, NULL ได้)&lt;br&gt;item_name : string&lt;br&gt;salary : decimal&lt;br&gt;estimated_shift_allowance : decimal&lt;br&gt;position_allowance : decimal&lt;br&gt;total_salary : decimal&lt;br&gt;purchase_price : decimal" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E3F2EE;strokeColor=#23806C;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="m_cc" value="&lt;b&gt;ebudget_cost_center_master&lt;/b&gt;&lt;br&gt;&lt;i&gt;(ศูนย์ต้นทุน)&lt;/i&gt;&lt;hr size=1&gt;id : bigint &lt;i&gt;(คีย์หลัก)&lt;/i&gt;&lt;br&gt;cost_center_name : string (unique)&lt;br&gt;description : string" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E3F2EE;strokeColor=#23806C;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- ============ Budget records column ============ -->
        <mxCell id="b_vet" value="&lt;b&gt;ebudget_vet_manpower&lt;/b&gt;&lt;br&gt;&lt;i&gt;(งบกำลังคนสัตวแพทย์)&lt;/i&gt;&lt;hr size=1&gt;id : bigint &lt;i&gt;(คีย์หลัก)&lt;/i&gt;&lt;br&gt;position_name : string&lt;br&gt;salary : decimal&lt;br&gt;base_branch_id : string &lt;i&gt;(ไม่ใช่ FK)&lt;/i&gt;&lt;br&gt;base_sub_branch_id : string &lt;i&gt;(ไม่ใช่ FK)&lt;/i&gt;&lt;br&gt;cost_center_name : string &lt;i&gt;(ไม่ใช่ FK)&lt;/i&gt;&lt;br&gt;document_no : string&lt;br&gt;item_master_id : bigint (FK, NULL ได้)&lt;br&gt;general_ledger_id : bigint (FK, NULL ได้)&lt;br&gt;create_date : timestamp&lt;br&gt;create_eid : string &lt;i&gt;(ไม่ใช่ FK ไป auth_user)&lt;/i&gt;&lt;br&gt;modify_date : timestamp&lt;br&gt;modify_eid : string" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E7EDFA;strokeColor=#2E5AAC;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1">
